# Frontend (aman untuk publik, dipakai browser, cuma bisa READ karena RLS)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-key-dari-supabase-project-settings-api

# Backend / serverless function saja (JANGAN taruh di frontend, JANGAN commit ke git)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-dari-supabase-project-settings-api
CRON_SECRET=bikin-random-string-panjang-sendiri

# Admin login (password sederhana, bukan Supabase Auth)
ADMIN_PASSWORD=bikin-password-sendiri-yang-cuma-lo-tau
ADMIN_SESSION_SECRET=bikin-random-string-panjang-lain-buat-signing-cookie
